def show_issues_and_fixes():
    """Issues detection and recommended fixes"""
    st.markdown("##### 🔧 Issues & Recommended Fixes")
    
    # Detect Issues
    issues = detect_system_issues()
    
    if issues:
        st.warning(f"⚠️ **{len(issues)} Issues Detected**")
        
        for i, issue in enumerate(issues, 1):
            with st.expander(f"🔍 Issue {i}: {issue['title']}"):
                st.markdown(f"**Problem:** {issue['description']}")
                st.markdown(f"**Impact:** {issue['impact']}")
                st.markdown(f"**🔧 Recommended Fix:**")
                st.code(issue['fix'])
                if issue.get('command'):
                    st.markdown("**Run Command:**")
                    st.code(issue['command'], language="bash")
    else:
        st.success("✅ **No Critical Issues Detected**")
        st.info("💡 System is healthy but awaiting data to demonstrate full functionality")
    
    # System Recommendations
    st.markdown("**🎯 System Optimization Recommendations**")
    
    recommendations = [
        {
            "Priority": "High",
            "Action": "Set up data ingestion",
            "Description": "Configure external API data sources to populate grade_changes table",
            "Benefit": "Enable full alert pipeline functionality"
        },
        {
            "Priority": "Medium", 
            "Action": "Add monitoring alerts",
            "Description": "Configure alerts for system failures and performance issues",
            "Benefit": "Proactive system health monitoring"
        },
        {
            "Priority": "Low",
            "Action": "Optimize scheduler frequency",
            "Description": "Adjust job intervals based on data volume and requirements",
            "Benefit": "Better resource utilization"
        }
    ]
    
    df_recs = pd.DataFrame(recommendations)
    st.dataframe(df_recs, use_container_width=True)

def detect_system_issues():
    """Detect system issues and return actionable fixes"""
    issues = []
    
    # Check API health
    try:
        health = api_call("GET", "/health", verbose=False)
        if not health.get("success"):
            issues.append({
                "title": "API Service Down",
                "description": "The alert API service is not responding",
                "impact": "All alert functionality is unavailable",
                "fix": "Restart the Python Worker service",
                "command": "docker-compose restart python-worker"
            })
    except:
        issues.append({
            "title": "API Connection Failed",
            "description": "Cannot connect to the alert API service",
            "impact": "All alert functionality is unavailable",
            "fix": "Check if Python Worker is running and accessible",
            "command": "docker-compose ps python-worker"
        })
    
    # Check database connectivity
    try:
        alerts_test = api_call("GET", "/alerts", params={"user_id": get_user_id(), "limit": 1}, verbose=False)
        if not alerts_test.get("success"):
            issues.append({
                "title": "Database Connection Issue",
                "description": "Alert service cannot connect to database",
                "impact": "Cannot store or retrieve alerts",
                "fix": "Check database connection and restart services",
                "command": "docker-compose restart postgres python-worker"
            })
    except:
        issues.append({
            "title": "Database Error",
            "description": "Database query failed",
            "impact": "Alert functionality may be degraded",
            "fix": "Check database logs and connectivity"
        })
    
    # Check for data flow (no grade changes)
    issues.append({
        "title": "No Data Flow Detected",
        "description": "No grade changes in the system - pipeline is idle",
        "impact": "Alert system is not processing any data",
        "fix": "Set up data ingestion from external APIs (FMP, Alpha Vantage, etc.)",
        "command": "# Configure data sources in admin panel"
    })
    
    return issues

def show_admin_overview():
    """Admin overview dashboard"""
    st.markdown("#### System Overview")
    
    # Get system metrics
    health = api_call("GET", "/health")
    metrics = api_call("GET", "/metrics")
    
    if health.get("success") and metrics.get("success"):
        health_data = health.get("health", {})
        metrics_data = metrics.get("metrics", {})
        
        # Key metrics
        col1, col2, col3, col4 = st.columns(4)
        
        with col1:
            st.metric("System Status", health_data.get("status", "Unknown").title())
        
        with col2:
            counters = metrics_data.get("counters", {})
            total_events = counters.get("universal_events_processed_total", 0)
            st.metric("Events Processed", f"{total_events:,}")
        
        with col3:
            st.metric("Pending Events", health_data.get("pending_events", 0))
        
        with col4:
            plugins = health_data.get("plugins", {})
            total_plugins = sum(len(plugin_list) for plugin_list in plugins.values())
            st.metric("Active Plugins", total_plugins)
        
        # Recent system events
        st.markdown("#### Recent System Events")
        
        # Get recent audit records for system operations
        audit_response = api_call("GET", "/audit-trail", params={"entity_type": "system", "limit": 20})
        
        if audit_response.get("success"):
            system_events = audit_response.get("audit_records", [])
            
            if system_events:
                for event in system_events:
                    col1, col2, col3 = st.columns([3, 1, 1])
                    
                    with col1:
                        st.write(f"**{event.get('operation_type', 'Unknown').title()}** - {event.get('entity_name', 'Unknown')}")
                    
                    with col2:
                        st.write(get_status_emoji(event.get('status', '')))
                    
                    with col3:
                        started_at = event.get('started_at', '')
                        if started_at:
                            dt = datetime.fromisoformat(started_at.replace('Z', '+00:00'))
                            st.write(dt.strftime('%H:%M:%S'))
            else:
                st.info("No recent system events")

def show_user_management():
    """User management interface"""
    st.markdown("#### User Management")
    
    # Get user statistics
    users_response = api_call("GET", "/admin/users")
    
    if not users_response.get("success"):
        st.error("Failed to load user data")
        return
    
    users = users_response.get("users", [])
    
    # User statistics
    col1, col2, col3, col4 = st.columns(4)
    
    total_users = len(users)
    active_users = len([u for u in users if u.get('is_active', True)])
    admin_users = len([u for u in users if u.get('role') == 'admin'])
    users_with_alerts = len([u for u in users if u.get('alert_count', 0) > 0])
    
    with col1:
        st.metric("Total Users", total_users)
    
    with col2:
        st.metric("Active Users", active_users)
    
    with col3:
        st.metric("Admin Users", admin_users)
    
    with col4:
        st.metric("Users with Alerts", users_with_alerts)
    
    # User list
    st.markdown("#### User List")
    
    for user in users[:20]:  # Limit to 20 for performance
        with st.expander(f"👤 {user.get('email', 'Unknown')} ({user.get('role', 'user')})"):
            col1, col2, col3 = st.columns(3)
            
            with col1:
                st.write(f"**ID:** {user.get('id', 'Unknown')}")
                st.write(f"**Name:** {user.get('name', 'Not set')}")
                st.write(f"**Role:** {user.get('role', 'user')}")
            
            with col2:
                st.write(f"**Active:** {'🟢 Yes' if user.get('is_active') else '🔴 No'}")
                st.write(f"**Alerts:** {user.get('alert_count', 0)}")
                st.write(f"**Created:** {user.get('created_at', 'Unknown')}")
            
            with col3:
                st.write(f"**Last Login:** {user.get('last_login_at', 'Never')}")
                st.write(f"**API Calls:** {user.get('api_call_count', 0)}")

def show_alert_management():
    """Alert management for administrators"""
    st.markdown("#### Alert Management")
    
    # Get all alerts (admin view)
    alerts_response = api_call("GET", "/admin/alerts")
    
    if not alerts_response.get("success"):
        st.error("Failed to load alerts")
        return
    
    alerts = alerts_response.get("alerts", [])
    
    # Alert statistics
    col1, col2, col3, col4 = st.columns(4)
    
    total_alerts = len(alerts)
    active_alerts = len([a for a in alerts if a.get('is_active', True)])
    failed_alerts = len([a for a in alerts if a.get('status') == 'failed'])
    test_alerts = len([a for a in alerts if a.get('is_test', False)])
    
    with col1:
        st.metric("Total Alerts", total_alerts)
    
    with col2:
        st.metric("Active Alerts", active_alerts)
    
    with col3:
        st.metric("Failed Alerts", failed_alerts)
    
    with col4:
        st.metric("Test Alerts", test_alerts)
    
    # Alert type distribution
    st.markdown("#### Alert Type Distribution")
    
    alert_types = {}
    for alert in alerts:
        alert_type = alert.get('alert_type', 'unknown')
        alert_types[alert_type] = alert_types.get(alert_type, 0) + 1
    
    if alert_types:
        fig = px.pie(
            values=list(alert_types.values()),
            names=list(alert_types.keys()),
            title="Alert Types"
        )
        st.plotly_chart(fig, use_container_width=True)
    
    # Recent alert events
    st.markdown("#### Recent Alert Events")
    
    events_response = api_call("GET", "/admin/alert-events", params={"limit": 20})
    
    if events_response.get("success"):
        events = events_response.get("events", [])
        
        for event in events:
            with st.expander(f"🔔 {event.get('alert_name', 'Unknown')} - {event.get('status', 'Unknown')}"):
                col1, col2 = st.columns(2)
                
                with col1:
                    st.write(f"**Alert ID:** {event.get('alert_id', 'Unknown')}")
                    st.write(f"**User:** {event.get('user_email', 'Unknown')}")
                    st.write(f"**Urgency:** {event.get('urgency_level', 'medium')}")
                
                with col2:
                    created_at = event.get('created_at', '')
                    if created_at:
                        dt = datetime.fromisoformat(created_at.replace('Z', '+00:00'))
                        st.write(f"**Created:** {dt.strftime('%Y-%m-%d %H:%M:%S')}")
                    
                    st.write(f"**Status:** {get_status_emoji(event.get('status', ''))} {event.get('status', '').title()}")

def show_plugin_management():
    """Plugin management interface"""
