def show_audit_trail_page():
    """Audit trail viewing page"""
    st.markdown("### 🔍 Audit Trail")
    
    # Get audit records
    audit_response = api_call("GET", "/audit-trail")
    
    if not audit_response.get("success"):
        st.error("Failed to load audit trail")
        return
    
    audit_records = audit_response.get("audit_records", [])
    
    if not audit_records:
        st.info("No audit records found")
        return
    
    # Filters
    col1, col2, col3, col4 = st.columns(4)
    
    with col1:
        entity_types = list(set(record.get('entity_type', '') for record in audit_records))
        entity_type_filter = st.selectbox("Entity Type", ["All"] + entity_types)
    
    with col2:
        operation_types = list(set(record.get('operation_type', '') for record in audit_records))
        operation_type_filter = st.selectbox("Operation Type", ["All"] + operation_types)
    
    with col3:
        status_types = list(set(record.get('status', '') for record in audit_records))
        status_filter = st.selectbox("Status", ["All"] + status_types)
    
    with col4:
        date_range = st.date_input("Date Range", [datetime.now() - timedelta(days=7), datetime.now()])
    
    # Time range filter
    if len(date_range) == 2:
        start_date, end_date = date_range
        filtered_records = [
            record for record in audit_records
            if start_date.date() <= datetime.fromisoformat(record.get('started_at', '').replace('Z', '+00:00')).date() <= end_date.date()
        ]
    else:
        filtered_records = audit_records
    
    # Apply filters
    if entity_type_filter != "All":
        filtered_records = [r for r in filtered_records if r.get('entity_type') == entity_type_filter]
    
    if operation_type_filter != "All":
        filtered_records = [r for r in filtered_records if r.get('operation_type') == operation_type_filter]
    
    if status_filter != "All":
        filtered_records = [r for r in filtered_records if r.get('status') == status_filter]
    
    st.markdown(f"#### {len(filtered_records)} Audit Records Found")
    
    # Search
    search_term = st.text_input("Search by entity name, ID, or error message", placeholder="Enter search term...")
    
    if search_term:
        search_term = search_term.lower()
        filtered_records = [
            r for r in filtered_records
            if search_term in r.get('entity_name', '').lower() 
            or search_term in r.get('entity_id', '').lower()
            or search_term in r.get('error_message', '').lower()
        ]
    
    # Display audit records
    for record in filtered_records[:50]:  # Limit to 50 for performance
        with st.expander(f"📋 {record.get('entity_type', 'Unknown').title()} - {record.get('operation_type', 'Unknown').title()} ({record.get('started_at', '')})"):
            col1, col2 = st.columns(2)
            
            with col1:
                st.write(f"**Entity:** {record.get('entity_name', record.get('entity_id', 'Unknown'))}")
                st.write(f"**Operation:** {record.get('operation_type', 'Unknown')}")
                st.write(f"**Status:** {get_status_emoji(record.get('status', ''))} {record.get('status', '').title()}")
                
                if record.get('duration_ms'):
                    st.write(f"**Duration:** {record['duration_ms']}ms")
                
                if record.get('impact_level'):
                    st.write(f"**Impact:** {record.get('impact_level', '').title()}")
            
            with col2:
                started_at = record.get('started_at', '')
                if started_at:
                    dt = datetime.fromisoformat(started_at.replace('Z', '+00:00'))
                    st.write(f"**Started:** {dt.strftime('%Y-%m-%d %H:%M:%S')}")
                
                completed_at = record.get('completed_at', '')
                if completed_at:
                    dt = datetime.fromisoformat(completed_at.replace('Z', '+00:00'))
                    st.write(f"**Completed:** {dt.strftime('%Y-%m-%d %H:%M:%S')}")
                
                if record.get('user_id'):
                    st.write(f"**User ID:** {record['user_id']}")
                
                if record.get('correlation_id'):
                    st.write(f"**Correlation ID:** {record['correlation_id']}")
            
            # Error details
            if record.get('error_message'):
                st.markdown("**Error Details:**")
                st.error(record['error_message'])
                
                if record.get('error_stack'):
                    with st.expander("View Error Stack"):
                        st.code(record['error_stack'], language='text')
            
            # Operation details
            if record.get('operation_data'):
                with st.expander("View Operation Data"):
                    st.json(record['operation_data'])
            
            # State changes
            if record.get('previous_state') or record.get('new_state'):
                col1, col2 = st.columns(2)
                
                with col1:
                    if record.get('previous_state'):
                        st.markdown("**Previous State:**")
                        st.json(record['previous_state'])
                
                with col2:
                    if record.get('new_state'):
                        st.markdown("**New State:**")
                        st.json(record['new_state'])
    
    # Export functionality
    if st.button("📥 Export Audit Records"):
        # Convert to DataFrame and download
        df = pd.DataFrame(filtered_records)
        csv = df.to_csv(index=False)
        st.download_button(
            label="Download CSV",
            data=csv,
            file_name=f"audit_trail_{datetime.now().strftime('%Y%m%d_%H%M%S')}.csv",
            mime="text/csv"
        )

def get_status_emoji(status):
    """Get emoji for status"""
    status_emojis = {
        "completed": "✅",
        "failed": "❌",
        "started": "🔄",
        "cancelled": "⏹️",
        "timeout": "⏰"
    }
    return status_emojis.get(status.lower(), "❓")

def show_scheduled_jobs_page():
    """Scheduled jobs monitoring page"""
    st.markdown("### ⏰ Scheduled Jobs")
    
    # Get scheduled jobs
    jobs_response = api_call("GET", "/scheduled-jobs")
    
    if not jobs_response.get("success"):
        st.error("Failed to load scheduled jobs")
        return
    
    jobs = jobs_response.get("jobs", [])
    
    if not jobs:
        st.info("No scheduled jobs found")
        return
    
    # Job statistics
    col1, col2, col3, col4 = st.columns(4)
    
    total_jobs = len(jobs)
    active_jobs = len([j for j in jobs if j.get('is_active', False)])
    failed_jobs = len([j for j in jobs if j.get('status') == 'failed'])
    running_jobs = len([j for j in jobs if j.get('status') == 'running'])
    
    with col1:
        st.metric("Total Jobs", total_jobs)
    
    with col2:
        st.metric("Active Jobs", active_jobs)
    
    with col3:
        st.metric("Running Jobs", running_jobs)
    
    with col4:
        st.metric("Failed Jobs", failed_jobs)
    
    # Job list
    st.markdown("#### Job List")
    
    for job in jobs:
        with st.expander(f"⚙️ {job.get('job_name', 'Unknown')} ({job.get('job_type', 'Unknown')})"):
            col1, col2, col3 = st.columns(3)
            
            with col1:
                status = job.get('status', 'unknown')
                status_color = {
                    'running': 'blue',
                    'completed': 'green',
                    'failed': 'red',
                    'scheduled': 'orange'
                }.get(status, 'gray')
                
                st.markdown(f"**Status:** :{status_color}[{status.title()}]")
                st.write(f"**Active:** {'🟢 Yes' if job.get('is_active') else '🔴 No'}")
                st.write(f"**Priority:** {job.get('priority', 3)}")
            
            with col2:
                schedule = job.get('schedule_config', {})
                if schedule.get('cron_expression'):
                    st.write(f"**Schedule:** {schedule['cron_expression']}")
                
                if job.get('next_run_time'):
                    next_run = datetime.fromisoformat(job['next_run_time'].replace('Z', '+00:00'))
                    st.write(f"**Next Run:** {next_run.strftime('%Y-%m-%d %H:%M:%S')}")
                
                if job.get('last_run_time'):
                    last_run = datetime.fromisoformat(job['last_run_time'].replace('Z', '+00:00'))
                    st.write(f"**Last Run:** {last_run.strftime('%Y-%m-%d %H:%M:%S')}")
            
            with col3:
                st.write(f"**Total Runs:** {job.get('total_runs', 0)}")
                st.write(f"**Success Rate:** {job.get('success_rate', 0):.1%}")
                st.write(f"**Avg Duration:** {job.get('avg_duration_ms', 0)}ms")
            
            # Recent executions
            executions = job.get('recent_executions', [])
            if executions:
                st.markdown("**Recent Executions:**")
                for exec_record in executions[:5]:
                    exec_status = exec_record.get('status', 'unknown')
                    exec_time = datetime.fromisoformat(exec_record['started_at'].replace('Z', '+00:00'))
                    
                    col1, col2, col3 = st.columns([2, 1, 1])
                    with col1:
                        st.write(f"• {exec_time.strftime('%Y-%m-%d %H:%M:%S')}")
                    with col2:
                        st.write(get_status_emoji(exec_status))
                    with col3:
                        if exec_record.get('duration_ms'):
                            st.write(f"{exec_record['duration_ms']}ms")
            
            # Job actions
            col1, col2, col3 = st.columns(3)
            
            with col1:
                if st.button("▶️ Run Now", key=f"run_{job.get('job_id')}"):
                    # Trigger job execution
                    result = api_call("POST", f"/scheduled-jobs/{job.get('job_id')}/run")
                    if result.get("success"):
                        st.success("Job triggered successfully")
                    else:
                        st.error("Failed to trigger job")
            
            with col2:
                toggle_text = "⏸️ Pause" if job.get('is_active') else "▶️ Resume"
                if st.button(toggle_text, key=f"toggle_{job.get('job_id')}"):
                    # Toggle job status
                    new_status = not job.get('is_active')
                    result = api_call("PUT", f"/scheduled-jobs/{job.get('job_id')}", data={"is_active": new_status})
                    if result.get("success"):
                        st.success(f"Job {'paused' if not new_status else 'resumed'}")
                    else:
                        st.error("Failed to update job")
            
            with col3:
                if st.button("📊 View History", key=f"history_{job.get('job_id')}"):
                    # Show job execution history
                    st.session_state[f'show_history_{job.get("job_id")}'] = True

