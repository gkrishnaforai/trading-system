            "recipient": "+1234567890",
            "subject": "GOOGL Price Alert",
            "status": "Failed",
            "sent_at": "2024-01-19 15:25:00"
        },
        {
            "type": "Push",
            "recipient": "device_123",
            "subject": "MSFT Grade Change",
            "status": "Delivered",
