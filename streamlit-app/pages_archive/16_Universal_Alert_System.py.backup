            smtp_port = st.number_input("SMTP Port", value=587)
        
        with col2:
            sms_enabled = st.checkbox("Enable SMS Notifications")
            sms_provider = st.selectbox("SMS Provider", ["Twilio", "AWS SNS", "Custom"])
            api_key = st.text_input("API Key", type="password")
        
        st.markdown("**Rate Limiting**")
        max_per_minute = st.number_input("Max Notifications Per Minute", 1, 1000, value=100)
        
        if st.form_submit_button("💾 Save Settings"):
            st.success("Notification settings saved successfully!")

def get_user_watchlist():
    """Get user's watchlist from API using the same pattern as other pages"""
    try:
        # Use the go_api_client for watchlist like other pages
        from api_client import get_go_api_client
        go_client = get_go_api_client()
        
        response = go_client.get("api/v1/watchlist", params={"user_id": get_user_id()})
        return [item.get('symbol', '') for item in response.get('watchlist', [])]
        
    except (APIConnectionError, APIError) as e:
        # If API fails, fallback to common symbols
        return ["AAPL", "MSFT", "GOOGL", "AMZN", "TSLA", "META", "NVDA"]
    except Exception as e:
        # Import fallback if client not available
        return ["AAPL", "MSFT", "GOOGL", "AMZN", "TSLA", "META", "NVDA"]

def show_bulk_alert_creation():
    """Bulk alert creation interface"""
    st.markdown("### 📝 Create Bulk Alerts")
    
    with st.form("bulk_alert_form"):
        st.markdown("#### Alert Template")
        
        col1, col2 = st.columns(2)
        
        with col1:
            base_alert_name = st.text_input("Base Alert Name*", placeholder="My Grade Change Alert")
            alert_type = st.selectbox("Alert Type*", ["earnings", "grade_change", "price_movement", "news_event", "custom"])
            alert_category = st.selectbox("Category", ["custom", "system", "premium"])
            priority_level = st.slider("Priority Level", 1, 5, value=3)
            is_test = st.checkbox("Test Alerts", value=True)
        
        with col2:
            st.markdown("**Notification Channels**")
            email_enabled = st.checkbox("Email", value=True)
            sms_enabled = st.checkbox("SMS")
            push_enabled = st.checkbox("Push Notification")
        
        st.markdown("#### Symbol Selection")
        symbol_input_method = st.radio("Select Symbols by", ["Manual Input", "From Watchlist", "From File"])
        
        symbols = []
        if symbol_input_method == "Manual Input":
            symbols_text = st.text_area("Enter symbols (one per line)", "AAPL\nMSFT\nGOOGL\nAMZN\nTSLA")
            symbols = [s.strip().upper() for s in symbols_text.split('\n') if s.strip()]
        elif symbol_input_method == "From Watchlist":
            watchlist = get_user_watchlist()
            selected_symbols = st.multiselect("Select from Watchlist", watchlist)
            symbols = selected_symbols
        elif symbol_input_method == "From File":
            uploaded_file = st.file_uploader("Upload CSV with symbols", type=['csv'])
            if uploaded_file:
                df = pd.read_csv(uploaded_file)
                if 'symbol' in df.columns:
                    symbols = df['symbol'].str.upper().tolist()
        
        st.markdown(f"**Selected Symbols:** {len(symbols) if symbols else 0}")
        
        # Common filters for all alerts
        st.markdown("#### Common Filters")
        
        col1, col2 = st.columns(2)
        
        with col1:
            if alert_type == "grade_change":
                include_upgrades = st.checkbox("Include Upgrades", value=True)
                include_downgrades = st.checkbox("Include Downgrades", value=True)
                tier_1_firms = st.checkbox("Tier-1 Firms Only")
            elif alert_type == "earnings":
                min_days_ahead = st.slider("Days Before Earnings", 1, 30, value=7)
                max_days_ahead = st.slider("Days After Earnings", 1, 30, value=1)
        
        with col2:
            data_sources = st.multiselect("Data Sources", ["fmp", "alpha_vantage"], default=["fmp"])
            min_confidence = st.slider("Min Confidence", 0.0, 1.0, value=0.5)
        
        # Preview
        if symbols and st.checkbox("Show Preview"):
            st.markdown("#### Preview")
            preview_alerts = []
            for i, symbol in enumerate(symbols[:5]):  # Show first 5
                alert_name = f"{base_alert_name} - {symbol}"
                preview_alerts.append({
                    "name": alert_name,
                    "symbol": symbol,
                    "type": alert_type,
                    "priority": priority_level
                })
            
            preview_df = pd.DataFrame(preview_alerts)
            st.dataframe(preview_df, use_container_width=True, hide_index=True)
            
            if len(symbols) > 5:
                st.info(f"... and {len(symbols) - 5} more alerts")
        
        # Submit
        submitted = st.form_submit_button("🚀 Create Bulk Alerts", type="primary")
        
        if submitted:
            if not base_alert_name or not symbols:
                st.error("Base alert name and at least one symbol are required")
                return
            
            # Build common configuration
            notification_channels = []
            if email_enabled:
                notification_channels.append("email")
            if sms_enabled:
                notification_channels.append("sms")
            if push_enabled:
                notification_channels.append("push")
            
            event_filters = {
                "data_sources": data_sources,
                "min_confidence": min_confidence
            }
            
            if alert_type == "grade_change":
                event_filters.update({
                    "include_upgrades": include_upgrades,
                    "include_downgrades": include_downgrades,
                    "tier_1_firms_only": tier_1_firms
                })
            elif alert_type == "earnings":
                event_filters.update({
                    "min_days_ahead": min_days_ahead,
                    "max_days_ahead": max_days_ahead
                })
            
            # Create alerts
            created_count = 0
            failed_count = 0
            
            progress_bar = st.progress(0)
            status_text = st.empty()
            
            for i, symbol in enumerate(symbols):
                status_text.text(f"Creating alert for {symbol} ({i+1}/{len(symbols)})")
                
                alert_request = {
                    "alert_name": f"{base_alert_name} - {symbol}",
                    "alert_type": alert_type,
                    "alert_category": alert_category,
                    "entity_filters": {"symbols": [symbol]},
                    "event_filters": event_filters,
                    "trigger_conditions": {},
                    "suppression_rules": {},
                    "notification_config": {"channels": notification_channels},
                    "priority_level": priority_level,
                    "is_test": is_test
                }
                
                result = api_call("POST", "/alerts", data=alert_request, params={"user_id": get_user_id()})
                
                if result.get("success"):
                    created_count += 1
                else:
                    failed_count += 1
                    st.error(f"Failed to create alert for {symbol}: {result.get('error')}")
                
                progress_bar.progress((i + 1) / len(symbols))
            
            status_text.text("✅ Bulk creation completed!")
            
            st.success(f"Successfully created {created_count} alerts")
            if failed_count > 0:
                st.warning(f"Failed to create {failed_count} alerts")

def show_alert_performance_details():
    """Show detailed performance for a specific alert"""
    selected_alert = st.session_state.get('selected_alert')
    
    if not selected_alert:
        st.warning("No alert selected")
        return
    
    st.markdown(f"### 📊 Performance: {selected_alert['alert_name']}")
    
    # Get performance metrics
    days = st.selectbox("Time Period", [7, 30, 90, 180], index=1)
    
    # Mock performance data (in production, fetch from API)
    performance_data = {
        "total_alerts": selected_alert.get('trigger_count', 0),
        "accuracy": 0.85,
        "avg_response_time": 2.5,  # minutes
        "success_rate": 0.92,
        "daily_performance": [
            {"date": "2024-01-15", "alerts": 3, "success": 3},
            {"date": "2024-01-16", "alerts": 2, "success": 2},
            {"date": "2024-01-17", "alerts": 5, "success": 4},
            {"date": "2024-01-18", "alerts": 1, "success": 1},
            {"date": "2024-01-19", "alerts": 4, "success": 4},
        ]
    }
    
    # Key metrics
    col1, col2, col3, col4 = st.columns(4)
    
    with col1:
        st.metric("Total Triggers", performance_data['total_alerts'])
    with col2:
        st.metric("Accuracy", f"{performance_data['accuracy']:.1%}")
    with col3:
        st.metric("Avg Response Time", f"{performance_data['avg_response_time']:.1f} min")
    with col4:
        st.metric("Success Rate", f"{performance_data['success_rate']:.1%}")
    
    # Performance chart
    if performance_data.get('daily_performance'):
        st.markdown("#### Daily Performance")
        
        df = pd.DataFrame(performance_data['daily_performance'])
        df['date'] = pd.to_datetime(df['date'])
        
        fig = go.Figure()
        fig.add_trace(go.Bar(
            x=df['date'],
            y=df['alerts'],
            name="Total Alerts",
            marker_color='lightblue'
        ))
        fig.add_trace(go.Bar(
            x=df['date'],
            y=df['success'],
            name="Successful",
            marker_color='darkblue'
        ))
        
        fig.update_layout(
            title="Daily Alert Performance",
            xaxis_title="Date",
            yaxis_title="Number of Alerts",
            barmode='overlay'
        )
        
        st.plotly_chart(fig, use_container_width=True)
    
    # Recent trigger history
    st.markdown("#### Recent Trigger History")
    
    # Mock trigger history
    trigger_history = [
        {"timestamp": "2024-01-19 14:30:00", "symbol": "AAPL", "event": "Grade Upgrade", "status": "Success"},
        {"timestamp": "2024-01-19 12:15:00", "symbol": "MSFT", "event": "Grade Downgrade", "status": "Success"},
        {"timestamp": "2024-01-19 09:45:00", "symbol": "GOOGL", "event": "Earnings Alert", "status": "Failed"},
    ]
    
    for trigger in trigger_history:
        status_icon = "✅" if trigger['status'] == "Success" else "❌"
        st.write(f"{status_icon} {trigger['timestamp']} - {trigger['symbol']}: {trigger['event']} ({trigger['status']})")

