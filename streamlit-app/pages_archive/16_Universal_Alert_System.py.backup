    for plugin_type, plugin_list in plugins.items():
        st.markdown(f"#### {plugin_type.title()} Plugins")
        
        for plugin in plugin_list:
            with st.expander(f"🔌 {plugin.get('plugin_name', 'Unknown')} ({plugin.get('version', 'Unknown')})"):
                col1, col2, col3 = st.columns(3)
                
                with col1:
                    st.write(f"**Class:** {plugin.get('plugin_class', 'Unknown')}")
                    st.write(f"**Author:** {plugin.get('author', 'Unknown')}")
                    st.write(f"**Builtin:** {'Yes' if plugin.get('is_builtin') else 'No'}")
                
                with col2:
                    health = plugin.get('health_status', 'unknown')
                    st.write(f"**Health:** {get_status_emoji(health)} {health.title()}")
                    st.write(f"**Active:** {'🟢 Yes' if plugin.get('is_active') else '🔴 No'}")
                    
                    last_check = plugin.get('last_health_check')
                    if last_check:
                        dt = datetime.fromisoformat(last_check.replace('Z', '+00:00'))
                        st.write(f"**Last Check:** {dt.strftime('%Y-%m-%d %H:%M:%S')}")
                
                with col3:
                    st.write(f"**Installed:** {plugin.get('installed_at', 'Unknown')}")
                    
                    supported_events = plugin.get('supported_event_types', [])
                    if supported_events:
                        st.write(f"**Events:** {', '.join(supported_events[:3])}")
                        if len(supported_events) > 3:
                            st.write(f"...+{len(supported_events) - 3} more")
                
                # Plugin configuration
                config = plugin.get('runtime_config', {})
                if config:
                    with st.expander("View Configuration"):
                        st.json(config)

def show_performance_monitoring():
    """Performance monitoring dashboard"""
    st.markdown("#### Performance Monitoring")
    
    # Get performance metrics
    metrics_response = api_call("GET", "/metrics")
    
    if not metrics_response.get("success"):
        st.error("Failed to load metrics")
        return
    
    metrics_data = metrics_response.get("metrics", {})
    
    # Performance counters
    counters = metrics_data.get("counters", {})
    gauges = metrics_data.get("gauges", {})
    histograms = metrics_data.get("histograms", {})
    
    # Key performance indicators
    col1, col2, col3, col4 = st.columns(4)
    
    with col1:
        st.metric("Events Processed", f"{counters.get('universal_events_processed_total', 0):,}")
    
    with col2:
        st.metric("Alerts Triggered", f"{counters.get('alerts_triggered_total', 0):,}")
    
    with col3:
        st.metric("Notifications Sent", f"{counters.get('notifications_sent_total', 0):,}")
    
    with col4:
        avg_response_time = gauges.get('average_response_time_ms', 0)
        st.metric("Avg Response Time", f"{avg_response_time:.0f}ms")
    
    # Performance charts
    st.markdown("#### Performance Trends")
    
    # Response time histogram
    if 'alert_processing_duration_ms' in histograms:
        histogram_data = histograms['alert_processing_duration_ms']
        
        fig = go.Figure()
        fig.add_trace(go.Histogram(
            x=histogram_data.get('samples', []),
            nbinsx=20,
            name='Alert Processing Duration'
        ))
        
        fig.update_layout(
            title="Alert Processing Duration Distribution",
            xaxis_title="Duration (ms)",
            yaxis_title="Count"
        )
        
        st.plotly_chart(fig, use_container_width=True)
    
    # Error rates
    st.markdown("#### Error Rates")
    
    error_counters = {k: v for k, v in counters.items() if 'error' in k.lower() or 'failure' in k.lower()}
    
    if error_counters:
        fig = go.Figure()
        
        fig.add_trace(go.Bar(
            x=list(error_counters.keys()),
            y=list(error_counters.values()),
            name="Errors/Failures"
        ))
        
        fig.update_layout(
            title="Error Counters",
            xaxis_title="Error Type",
            yaxis_title="Count"
        )
        
        st.plotly_chart(fig, use_container_width=True)
    
    # System resource usage
    st.markdown("#### System Resources")
    
    resource_gauges = {k: v for k, v in gauges.items() if any(keyword in k.lower() for keyword in ['memory', 'cpu', 'disk', 'connection'])}
    
    if resource_gauges:
        for metric_name, value in resource_gauges.items():
            col1, col2 = st.columns([1, 3])
            with col1:
                st.write(f"**{metric_name}:**")
            with col2:
                # Progress bar for percentage metrics
                if 'percent' in metric_name.lower() or 'usage' in metric_name.lower():
                    st.progress(min(value / 100, 1.0), text=f"{value:.1f}%")
                else:
                    st.metric("", f"{value}")

def show_notifications_panel():
    """Real-time notifications panel"""
    # Initialize notifications in session state if not exists
    if 'notifications' not in st.session_state:
        st.session_state.notifications = deque(maxlen=50)  # Keep last 50 notifications
    
    # Add refresh button
    col1, col2 = st.columns([1, 4])
    
    with col1:
        if st.button("🔄 Refresh", key="refresh_notifications"):
            fetch_latest_notifications()
    
    with col2:
        st.markdown("### 🔔 Real-time Notifications")
    
    # Notification filters
    col1, col2, col3 = st.columns(3)
    
    with col1:
        notification_type = st.selectbox("Filter by Type", ["All", "Alert", "System", "Error", "Success"])
    
    with col2:
        show_only_unread = st.checkbox("Unread Only")
    
    with col3:
        if st.button("🗑️ Clear All"):
            st.session_state.notifications.clear()
            st.rerun()
    
    # Display notifications
    notifications = list(st.session_state.notifications)
    
    # Apply filters
    if notification_type != "All":
        notifications = [n for n in notifications if n.get('type', '').lower() == notification_type.lower()]
    
    if show_only_unread:
        notifications = [n for n in notifications if n.get('unread', True)]
    
    if not notifications:
        st.info("No notifications to display")
        return
    
    # Display notifications with newest first
    for notification in reversed(notifications):
        with st.container():
            col1, col2, col3 = st.columns([1, 8, 1])
            
            with col1:
                # Notification icon based on type
                icon_map = {
                    'alert': '🔔',
                    'system': '⚙️',
                    'error': '❌',
                    'success': '✅',
                    'warning': '⚠️',
                    'info': 'ℹ️'
                }
                st.write(icon_map.get(notification.get('type', 'info'), '📢'))
            
            with col2:
                # Notification content
                if notification.get('unread', True):
                    st.markdown(f"**{notification.get('title', 'Notification')}**")
                else:
                    st.markdown(f"{notification.get('title', 'Notification')}")
                
                st.write(notification.get('message', ''))
                
                # Timestamp
                timestamp = notification.get('timestamp', datetime.now())
                if isinstance(timestamp, str):
                    timestamp = datetime.fromisoformat(timestamp.replace('Z', '+00:00'))
                
                time_ago = datetime.now() - timestamp
                if time_ago.total_seconds() < 60:
                    time_str = "Just now"
                elif time_ago.total_seconds() < 3600:
                    time_str = f"{int(time_ago.total_seconds() / 60)} min ago"
                elif time_ago.total_seconds() < 86400:
                    time_str = f"{int(time_ago.total_seconds() / 3600)} hours ago"
                else:
                    time_str = timestamp.strftime('%Y-%m-%d %H:%M')
                
                st.caption(time_str)
            
            with col3:
                # Mark as read button
                if notification.get('unread', True):
                    if st.button("👁️", key=f"read_{notification.get('id', id(notification))}"):
                        notification['unread'] = False
                        st.rerun()
                
                # Delete button
                if st.button("❌", key=f"delete_{notification.get('id', id(notification))}"):
                    st.session_state.notifications.remove(notification)
                    st.rerun()
            
            st.divider()

def fetch_latest_notifications():
    """Fetch latest notifications from API"""
    try:
        # Get recent system events and alert events
        system_events = api_call("GET", "/audit-trail", params={"entity_type": "system", "limit": 10})
        alert_events = api_call("GET", "/admin/alert-events", params={"limit": 10})
        
        # Add system events as notifications
        if system_events.get("success"):
            for event in system_events.get("audit_records", []):
                notification = {
                    'id': f"system_{event.get('audit_id')}",
                    'type': 'system',
                    'title': f"System {event.get('operation_type', 'Event').title()}",
                    'message': f"{event.get('entity_name', 'Unknown')} - {event.get('status', '').title()}",
                    'timestamp': event.get('started_at', datetime.now()),
                    'unread': True
                }
                st.session_state.notifications.append(notification)
        
        # Add alert events as notifications
        if alert_events.get("success"):
            for event in alert_events.get("events", []):
                notification_type = 'alert' if event.get('status') == 'sent' else 'error' if event.get('status') == 'failed' else 'info'
                
                notification = {
                    'id': f"alert_{event.get('event_id')}",
                    'type': notification_type,
                    'title': f"Alert {event.get('status', '').title()}",
                    'message': f"{event.get('alert_name', 'Unknown')} for {event.get('user_email', 'Unknown')}",
                    'timestamp': event.get('created_at', datetime.now()),
                    'unread': True
                }
                st.session_state.notifications.append(notification)
                
    except Exception as e:
        st.error(f"Failed to fetch notifications: {str(e)}")

def show_enhanced_analytics_page():
    """Enhanced analytics page with performance reporting"""
    st.markdown("### 📊 Advanced Analytics & Performance Reporting")
    
    # Time range selector
    col1, col2, col3 = st.columns(3)
    
    with col1:
        time_range = st.selectbox("Time Range", ["Last 24 Hours", "Last 7 Days", "Last 30 Days", "Last 90 Days"])
    
    with col2:
        alert_type_filter = st.selectbox("Alert Type Filter", ["All", "earnings", "grade_change", "price_movement", "news_event"])
    
    with col3:
        if st.button("📊 Generate Report"):
            st.session_state['generate_report'] = True
    
    # Get analytics data
    user_id = get_user_id()
    days_map = {"Last 24 Hours": 1, "Last 7 Days": 7, "Last 30 Days": 30, "Last 90 Days": 90}
    days = days_map.get(time_range, 30)
    
    stats_response = api_call("GET", "/statistics", params={"user_id": user_id, "days": days})
    
    if not stats_response.get("success"):
        st.error("Failed to load analytics data")
        return
    
    stats = stats_response.get("statistics", {})
    
    # Key Performance Indicators
    st.markdown("#### 🎯 Key Performance Indicators")
    
    col1, col2, col3, col4 = st.columns(4)
    
    with col1:
        st.metric("Total Alerts", stats.get("total_alerts", 0))
        delta = stats.get("alerts_growth_rate", 0)
        st.caption(f"Growth: {delta:+.1f}%")
    
    with col2:
        st.metric("Success Rate", f"{stats.get('success_rate', 0):.1f}%")
        delta = stats.get("success_rate_change", 0)
        st.caption(f"Change: {delta:+.1f}%")
    
    with col3:
        st.metric("Avg Response Time", f"{stats.get('average_response_time_ms', 0):.0f}ms")
        delta = stats.get('response_time_change', 0)
        st.caption(f"Change: {delta:+.0f}ms")
    
    with col4:
        st.metric("Notifications Sent", stats.get("notifications_sent", 0))
        delta = stats.get("notifications_growth_rate", 0)
        st.caption(f"Growth: {delta:+.1f}%")
    
    # Alert Performance Trends
    st.markdown("#### 📈 Alert Performance Trends")
    
    # Get time series data
    trends_response = api_call("GET", "/analytics/trends", params={"days": days, "alert_type": alert_type_filter if alert_type_filter != "All" else None})
    
    if trends_response.get("success"):
        trends = trends_response.get("trends", {})
        
        # Create subplots for multiple metrics
        fig = go.Figure()
        
        # Alert volume trend
        if 'alert_volume' in trends:
            alert_data = trends['alert_volume']
            fig.add_trace(go.Scatter(
                x=alert_data.get('timestamps', []),
                y=alert_data.get('values', []),
                mode='lines+markers',
                name='Alert Volume',
                line=dict(color='blue')
            ))
        
        # Success rate trend
        if 'success_rate' in trends:
            success_data = trends['success_rate']
            fig.add_trace(go.Scatter(
                x=success_data.get('timestamps', []),
                y=success_data.get('values', []),
                mode='lines+markers',
                name='Success Rate (%)',
                line=dict(color='green'),
                yaxis='y2'
            ))
        
        # Create dual y-axis layout
        fig.update_layout(
            title="Alert Performance Trends",
            xaxis_title="Time",
            yaxis=dict(title="Alert Volume", side="left"),
            yaxis2=dict(title="Success Rate (%)", side="right", overlaying="y"),
            legend=dict(x=0, y=1.1, orientation="h")
        )
        
        st.plotly_chart(fig, use_container_width=True)
    
    # Alert Type Performance Comparison
    st.markdown("#### 📊 Alert Type Performance Comparison")
    
    alert_performance = stats.get("alert_type_performance", {})
    
    if alert_performance:
        # Create performance comparison chart
        types = list(alert_performance.keys())
        volumes = [alert_performance[t].get('volume', 0) for t in types]
        success_rates = [alert_performance[t].get('success_rate', 0) for t in types]
        
        fig = go.Figure()
        
        # Add volume bars
        fig.add_trace(go.Bar(
            x=types,
            y=volumes,
            name='Alert Volume',
            yaxis='y'
        ))
        
        # Add success rate line
        fig.add_trace(go.Scatter(
            x=types,
            y=success_rates,
            mode='lines+markers',
            name='Success Rate (%)',
            yaxis='y2'
        ))
        
        fig.update_layout(
            title="Alert Type Performance Comparison",
            xaxis_title="Alert Type",
            yaxis=dict(title="Volume", side="left"),
            yaxis2=dict(title="Success Rate (%)", side="right", overlaying="y"),
            legend=dict(x=0, y=1.1, orientation="h")
        )
        
        st.plotly_chart(fig, use_container_width=True)
    
    # Error Analysis
    st.markdown("#### 🚨 Error Analysis")
    
    error_stats = stats.get("error_analysis", {})
    
    if error_stats:
        col1, col2 = st.columns(2)
        
        with col1:
            # Error types breakdown
            error_types = error_stats.get('error_types', {})
            if error_types:
                fig = px.pie(
                    values=list(error_types.values()),
                    names=list(error_types.keys()),
                    title="Error Types Distribution"
                )
                st.plotly_chart(fig, use_container_width=True)
        
        with col2:
            # Top error messages
            top_errors = error_stats.get('top_errors', [])
            if top_errors:
                st.markdown("**Top Error Messages:**")
                for i, error in enumerate(top_errors[:5], 1):
                    st.write(f"{i}. {error.get('message', 'Unknown')} ({error.get('count', 0)} occurrences)")
    
    # Performance Report Generation
    if st.session_state.get('generate_report', False):
        st.markdown("#### 📄 Performance Report")
        
        # Generate report data
        report_data = {
            "report_generated_at": datetime.now().isoformat(),
            "time_range": time_range,
            "user_id": user_id,
            "statistics": stats,
            "trends": trends_response.get("trends", {}) if trends_response.get("success") else {}
        }
        
        # Report summary
        st.markdown("**Executive Summary:**")
        st.write(f"- Total alerts processed: {stats.get('total_alerts', 0):,}")
        st.write(f"- Overall success rate: {stats.get('success_rate', 0):.1f}%")
        st.write(f"- Average response time: {stats.get('average_response_time_ms', 0):.0f}ms")
        st.write(f"- Notifications delivered: {stats.get('notifications_sent', 0):,}")
        
        # Download report
        if st.button("📥 Download Full Report"):
            report_json = json.dumps(report_data, indent=2, default=str)
            st.download_button(
                label="Download JSON Report",
                data=report_json,
                file_name=f"alert_performance_report_{datetime.now().strftime('%Y%m%d_%H%M%S')}.json",
                mime="application/json"
            )
        
        # Clear report generation flag
        st.session_state['generate_report'] = False

def show_scheduled_jobs_page():
    """Scheduled jobs management page"""
    st.markdown("### ⏰ Scheduled Jobs")
    
    st.markdown("#### Active Scheduled Jobs")
    
    # Mock scheduled jobs data
    jobs = [
        {
            "name": "Earnings Data Collection",
            "schedule": "0 6 * * *",
            "status": "Active",
            "last_run": "2024-01-19 06:00:00",
            "next_run": "2024-01-20 06:00:00"
        },
        {
            "name": "Analyst Grades Collection",
            "schedule": "*/30 * * * *",
            "status": "Active",
            "last_run": "2024-01-19 15:30:00",
            "next_run": "2024-01-19 16:00:00"
        },
        {
            "name": "Alert Processing",
            "schedule": "*/5 * * * *",
            "status": "Active",
            "last_run": "2024-01-19 15:55:00",
            "next_run": "2024-01-19 16:00:00"
        }
    ]
    
    for job in jobs:
        with st.expander(f"⏰ {job['name']}"):
            col1, col2, col3, col4 = st.columns(4)
            
            with col1:
                st.write(f"**Schedule:** {job['schedule']}")
            with col2:
                status_color = "🟢" if job['status'] == "Active" else "🔴"
                st.write(f"**Status:** {status_color} {job['status']}")
            with col3:
                st.write(f"**Last Run:** {job['last_run']}")
            with col4:
                st.write(f"**Next Run:** {job['next_run']}")
            
            col1, col2, col3 = st.columns(3)
            with col1:
                if st.button("▶️ Run Now", key=f"run_{job['name']}"):
                    st.success(f"Triggered {job['name']} manually")
            with col2:
                if st.button("⏸️ Pause", key=f"pause_{job['name']}"):
                    st.warning(f"Paused {job['name']}")
            with col3:
                if st.button("⚙️ Configure", key=f"config_{job['name']}"):
                    st.info(f"Configuration for {job['name']}")
    
    st.markdown("#### Add New Scheduled Job")
    
    with st.form("add_scheduled_job"):
        col1, col2 = st.columns(2)
        
        with col1:
            job_name = st.text_input("Job Name*")
            job_type = st.selectbox("Job Type", ["Data Collection", "Alert Processing", "Report Generation", "Cleanup"])
        
        with col2:
            schedule = st.text_input("Cron Schedule*", placeholder="0 6 * * *")
            enabled = st.checkbox("Enabled", value=True)
        
        if st.form_submit_button("➕ Add Job"):
            if job_name and schedule:
                st.success(f"Scheduled job '{job_name}' added successfully!")
            else:
                st.error("Job name and schedule are required")

def show_notifications_panel():
