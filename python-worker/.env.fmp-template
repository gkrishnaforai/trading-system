# ============================================
# FMP (Financial Modeling Prep) Configuration
# ============================================
# Copy this file to .env and add your FMP API key
# Get your API key from: https://site.financialmodelingprep.com/developer

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/trading-system?sslmode=disable

# Redis Configuration  
REDIS_URL=redis://localhost:6379/0

# Logging Configuration
LOG_LEVEL=INFO

# Financial Modeling Prep (FMP) API Configuration
FMP_API_KEY=your_fmp_api_key_here
FMP_ENABLED=true
FMP_BASE_URL=https://financialmodelingprep.com/stable
FMP_TIMEOUT=30
FMP_MAX_RETRIES=3
FMP_RETRY_DELAY=1.0
FMP_RATE_LIMIT_CALLS=60
FMP_RATE_LIMIT_WINDOW=60.0

# Data Source Orchestration
# IMPORTANT: Set PRIMARY_DATA_PROVIDER to fmp to ensure FMP is used as primary
# FMP is set as the PRIMARY and DEFAULT data provider
PRIMARY_DATA_PROVIDER=fmp
FALLBACK_DATA_PROVIDER=yahoo_finance
DEFAULT_DATA_PROVIDER=fmp

# Yahoo Finance (always available as fallback)
YAHOO_FINANCE_ENABLED=true

# Data Fetch Configuration
DATA_FETCH_RETRY_ATTEMPTS=3
DATA_FETCH_RETRY_DELAY=5

# Batch Scheduler Configuration
BATCH_SCHEDULE_HOUR=1
BATCH_SCHEDULE_MINUTE=0

# Optional: Other API Keys (for fallback or additional features)
ALPHAVANTAGE_API_KEY=your_alphavantage_key_here
OPENAI_API_KEY=your_openai_key_here
